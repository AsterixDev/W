{
  "manifest_version": 3,
  "name": "Safari Enhancer",
  "version": "1.0",
  "description": "Smart dark mode, custom toolbar colour, and volume boost for every page.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "images/icon-16.png",
      "48":  "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },

  "icons": {
    "16":  "images/icon-16.png",
    "48":  "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
